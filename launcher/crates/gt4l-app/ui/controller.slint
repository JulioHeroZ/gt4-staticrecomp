// Original line drawing of a PS2 pad (not a Sony design). Each hotspot is a button of the pad; clicking
// one selects it for rebinding. Labels inside the hotspots show the primary binding of the input.
import { Palette } from "tokens.slint";
import { ComboBox, Slider } from "std-widgets.slint";

component Hotspot inherits Rectangle {
    in property <string> label;
    in property <bool> round: false;
    in property <bool> selected: false;
    callback clicked();
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Palette.accent : Palette.dim;
    background: touch.has-hover ? Palette.graphite : #00000066;
    border-radius: root.round ? root.width / 2 : 4px;
    Text {
        text: root.label;
        color: root.selected ? Palette.white : Palette.silver;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

export component ControllerView inherits Rectangle {
    width: 620px;
    height: 330px;
    // Primary binding label for each input, in this order:
    // 0 dpad_up, 1 dpad_right, 2 dpad_down, 3 dpad_left, 4 cross, 5 circle, 6 square, 7 triangle,
    // 8 l1, 9 r1, 10 l2, 11 r2, 12 l3, 13 r3, 14 select, 15 start (16 and 17 are unused).
    in property <[string]> captions;
    // Index into the order above, or -1 for none.
    in-out property <int> selected: -1;
    callback select(int);

    Path {
        width: 620px;
        height: 330px;
        commands: "M 130 70 L 490 70 C 560 70 600 120 600 185 C 600 260 580 300 530 305 L 90 305 C 40 300 20 260 20 185 C 20 120 60 70 130 70 Z";
        fill: #1E2229;
        stroke: #5C626B;
        stroke-width: 1px;
    }

    // Shoulders and triggers (behind the body edge).
    Hotspot { x: 110px; y: 22px; width: 90px; height: 20px; label: captions[10]; selected: root.selected == 10; clicked => { root.select(10); } }
    Hotspot { x: 420px; y: 22px; width: 90px; height: 20px; label: captions[11]; selected: root.selected == 11; clicked => { root.select(11); } }
    Hotspot { x: 110px; y: 48px; width: 90px; height: 16px; label: captions[8]; selected: root.selected == 8; clicked => { root.select(8); } }
    Hotspot { x: 420px; y: 48px; width: 90px; height: 16px; label: captions[9]; selected: root.selected == 9; clicked => { root.select(9); } }

    // D-pad.
    Hotspot { x: 135px; y: 116px; width: 30px; height: 34px; label: captions[0]; selected: root.selected == 0; clicked => { root.select(0); } }
    Hotspot { x: 165px; y: 150px; width: 34px; height: 30px; label: captions[1]; selected: root.selected == 1; clicked => { root.select(1); } }
    Hotspot { x: 135px; y: 184px; width: 30px; height: 34px; label: captions[2]; selected: root.selected == 2; clicked => { root.select(2); } }
    Hotspot { x: 101px; y: 150px; width: 34px; height: 30px; label: captions[3]; selected: root.selected == 3; clicked => { root.select(3); } }

    // Face buttons.
    Hotspot { x: 455px; y: 108px; width: 30px; height: 30px; round: true; label: captions[7]; selected: root.selected == 7; clicked => { root.select(7); } }
    Hotspot { x: 485px; y: 138px; width: 30px; height: 30px; round: true; label: captions[5]; selected: root.selected == 5; clicked => { root.select(5); } }
    Hotspot { x: 455px; y: 168px; width: 30px; height: 30px; round: true; label: captions[4]; selected: root.selected == 4; clicked => { root.select(4); } }
    Hotspot { x: 425px; y: 138px; width: 30px; height: 30px; round: true; label: captions[6]; selected: root.selected == 6; clicked => { root.select(6); } }

    // Select and Start.
    Hotspot { x: 225px; y: 150px; width: 36px; height: 14px; label: captions[14]; selected: root.selected == 14; clicked => { root.select(14); } }
    Hotspot { x: 359px; y: 150px; width: 36px; height: 14px; label: captions[15]; selected: root.selected == 15; clicked => { root.select(15); } }

    // Sticks: clicking a stick selects its stick-click input (L3 / R3).
    Hotspot { x: 200px; y: 210px; width: 60px; height: 60px; round: true; label: captions[12]; selected: root.selected == 12; clicked => { root.select(12); } }
    Hotspot { x: 360px; y: 210px; width: 60px; height: 60px; round: true; label: captions[13]; selected: root.selected == 13; clicked => { root.select(13); } }
}

// Analog trigger tuning for L2 and R2: deadzone and curve, with a live preview of the pressure curve.
export component TriggerPanel inherits Rectangle {
    width: 300px;
    height: 150px;
    // 0 = L2, 1 = R2
    in property <int> trigger: 0;
    in property <float> deadzone: 0.1176;
    in property <int> curve: 0;
    in property <string> deadzone-text;
    callback changed(int, float, int);

    Text {
        x: 0px;
        y: 0px;
        text: root.trigger == 0 ? "L2 (from LT)" : "R2 (from RT)";
        color: Palette.silver;
        font-size: 13px;
    }
    Text {
        x: 0px;
        y: 20px;
        width: 300px;
        text: "Deadzone";
        color: Palette.dim;
        font-size: 12px;
    }
    Slider {
        x: 0px;
        y: 38px;
        width: 180px;
        minimum: 0;
        maximum: 0.5;
        value: root.deadzone;
        changed(v) => { root.changed(root.trigger, v, root.curve); }
    }
    Text {
        x: 190px;
        y: 38px;
        text: root.deadzone-text;
        color: Palette.silver;
        font-size: 12px;
    }
    Text {
        x: 0px;
        y: 70px;
        text: "Curve";
        color: Palette.dim;
        font-size: 12px;
    }
    ComboBox {
        x: 0px;
        y: 88px;
        width: 180px;
        model: ["Linear", "Quadratic", "Cubic", "S-Curve", "Smooth Power", "Sublinear", "Logarithmic"];
        current-index: root.curve;
        selected(value) => {
            root.changed(root.trigger, root.deadzone,
                value == "Quadratic" ? 1 : (
                value == "Cubic" ? 2 : (
                value == "S-Curve" ? 3 : (
                value == "Smooth Power" ? 4 : (
                value == "Sublinear" ? 5 : (
                value == "Logarithmic" ? 6 : 0))))));
        }
    }
    // Preview: pressure (vertical) against trigger travel (horizontal). Linear is the straight line.
    Path {
        x: 200px;
        y: 70px;
        width: 90px;
        height: 70px;
        // 21 samples of the same unit-interval formulas used by native/controls.cpp.
        commands: root.curve == 1 ? "M 0.00 70.00 L 4.50 69.83 L 9.00 69.30 L 13.50 68.42 L 18.00 67.20 L 22.50 65.62 L 27.00 63.70 L 31.50 61.43 L 36.00 58.80 L 40.50 55.82 L 45.00 52.50 L 49.50 48.83 L 54.00 44.80 L 58.50 40.42 L 63.00 35.70 L 67.50 30.62 L 72.00 25.20 L 76.50 19.43 L 81.00 13.30 L 85.50 6.83 L 90.00 0.00" : (root.curve == 2 ? "M 0.00 70.00 L 4.50 69.99 L 9.00 69.93 L 13.50 69.76 L 18.00 69.44 L 22.50 68.91 L 27.00 68.11 L 31.50 67.00 L 36.00 65.52 L 40.50 63.62 L 45.00 61.25 L 49.50 58.35 L 54.00 54.88 L 58.50 50.78 L 63.00 45.99 L 67.50 40.47 L 72.00 34.16 L 76.50 27.01 L 81.00 18.97 L 85.50 9.98 L 90.00 0.00" : (root.curve == 3 ? "M 0.00 70.00 L 4.50 69.49 L 9.00 68.04 L 13.50 65.75 L 18.00 62.72 L 22.50 59.06 L 27.00 54.88 L 31.50 50.28 L 36.00 45.36 L 40.50 40.23 L 45.00 35.00 L 49.50 29.77 L 54.00 24.64 L 58.50 19.72 L 63.00 15.12 L 67.50 10.94 L 72.00 7.28 L 76.50 4.25 L 81.00 1.96 L 85.50 0.51 L 90.00 0.00" : (root.curve == 4 ? "M 0.00 70.00 L 4.50 69.22 L 9.00 67.79 L 13.50 65.93 L 18.00 63.74 L 22.50 61.25 L 27.00 58.50 L 31.50 55.51 L 36.00 52.29 L 40.50 48.87 L 45.00 45.25 L 49.50 41.45 L 54.00 37.47 L 58.50 33.32 L 63.00 29.00 L 67.50 24.53 L 72.00 19.91 L 76.50 15.14 L 81.00 10.23 L 85.50 5.18 L 90.00 0.00" : (root.curve == 5 ? "M 0.00 70.00 L 4.50 54.35 L 9.00 47.86 L 13.50 42.89 L 18.00 38.70 L 22.50 35.00 L 27.00 31.66 L 31.50 28.59 L 36.00 25.73 L 40.50 23.04 L 45.00 20.50 L 49.50 18.09 L 54.00 15.78 L 58.50 13.56 L 63.00 11.43 L 67.50 9.38 L 72.00 7.39 L 76.50 5.46 L 81.00 3.59 L 85.50 1.77 L 90.00 0.00" : (root.curve == 6 ? "M 0.00 70.00 L 4.50 58.70 L 9.00 50.49 L 13.50 44.03 L 18.00 38.70 L 22.50 34.17 L 27.00 30.23 L 31.50 26.74 L 36.00 23.61 L 40.50 20.77 L 45.00 18.17 L 49.50 15.78 L 54.00 13.57 L 58.50 11.50 L 63.00 9.57 L 67.50 7.75 L 72.00 6.03 L 76.50 4.41 L 81.00 2.87 L 85.50 1.40 L 90.00 0.00" : ("M 0.00 70.00 L 4.50 66.50 L 9.00 63.00 L 13.50 59.50 L 18.00 56.00 L 22.50 52.50 L 27.00 49.00 L 31.50 45.50 L 36.00 42.00 L 40.50 38.50 L 45.00 35.00 L 49.50 31.50 L 54.00 28.00 L 58.50 24.50 L 63.00 21.00 L 67.50 17.50 L 72.00 14.00 L 76.50 10.50 L 81.00 7.00 L 85.50 3.50 L 90.00 0.00"))))));
        stroke: Palette.accent;
        stroke-width: 2px;
        fill: transparent;
    }
}
